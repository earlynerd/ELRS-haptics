		(uuid "7254d357-f96e-4569-a329-3be78e436472")
	)
	(text "Connector bypass"
		(exclude_from_sim no)
		(at 25.4 134.62 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "a8944696-7ada-412b-b253-f9ad8ce9793c")
	)
	(text "USB_VBUS connects directly to charger U11 IN and C34.\nBQ25186 provides input-current limiting; no external current selector.\nNo CC current-advertisement detection or USB PD negotiation.\nRead VIN_PGOOD_STAT over charger I2C for usable input-power status.\nNo discrete VBUS detector or UART service bank."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cd989401-cb75-4702-8f76-67c8ebe71bfa")
	)
