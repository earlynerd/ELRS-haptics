	)
	(text "R60 and R61 each terminate one CC pin to GND.\nUSB 2.0 contacts are paired for either plug orientation.\nC29/C30 remain optional DNP tuning capacitors."
		(exclude_from_sim no)
		(at 238.76 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
