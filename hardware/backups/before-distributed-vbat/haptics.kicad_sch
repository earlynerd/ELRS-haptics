(kicad_sch (version 20250114) (generator "eeschema") (uuid 19987bf9-b7d7-4fc0-8def-b05461281d18) (paper "A3") (embedded_fonts no) (lib_symbols) (title_block (title "Haptic bracelet - UART ring wiring") (date "2026-09-12") (rev "0.3") (comment 1 "One wrist / ring pod schematic draft")) (text "EIGHT PODS / ONE FORWARDED UART DATA WIRE PER GAP" (at 20.32 15.24 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid d0469d42-f487-4f2a-a0a6-6ddc0aec57f8)) (text "Each pod: M2003FC1AE + DRV2625 + LRA. Pod 0 shares its housing with the ESP32/power electronics." (at 20.32 27.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid a3cb6076-a69f-407d-99f0-ed80eb90651c)) (text "IN/OUT pin order: 1 POD_3V3, 2 GND, 3 DATA, 4 RING_nRESET. Battery branch wiring is additional." (at 20.32 35.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 13175acc-6f0b-4048-aee4-f634f9576135)) (text "ESP TX -> D0 -> pod 0 -> D1 -> ... -> pod 7 -> D8 -> ESP RX\nPower, ground and reset are common; DATA is point-to-point, not a multidrop net.\nWiring is represented electrically here; physical closure, pad geometry and panelization remain open." (at 20.32 228.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 4f281aac-3bdf-4056-aa73-4be97600f9b6)) (sheet (at 35.56 68.58) (size 60.96 40.64) (stroke (width 0.254) (type default)) (fill (color 0 0 0 0)) (uuid 4d6e4dab-563d-4ead-a838-c723bec990f2) (property "Sheetname" "Pod 0 / U18" (at 35.56 66.03999999999999 0) (effects (font (size 1.0 1.0)) (justify left))) (property "Sheetfile" "pod_0.kicad_sch" (at 35.56 111.76 0) (effects (font (size 1.0 1.0)) (justify left))) (pin "RING_RX" input (at 35.56 83.82 180) (effects (font (size 1.0 1.0)) (justify left)) (uuid 89b9a5d2-60a5-4dc8-8383-144f3c742ec7)) (pin "RING_TX" output (at 96.52000000000001 93.97999999999999 0) (effects (font (size 1.0 1.0)) (justify right)) (uuid b0644ed3-fab2-470c-975a-ce1cf9b636a4)) (instances (project "haptic-bracelet" (path "/281e434a-bf9f-432