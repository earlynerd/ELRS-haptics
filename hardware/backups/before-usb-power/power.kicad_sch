(kicad_sch (version 20250114) (generator "eeschema") (uuid 8e9df9e7-353c-4da9-8090-adb54d492640) (paper "A3") (title_block (title "Haptic bracelet - battery and power design pending") (date "2026-09-11") (rev "0.1") (comment 1 "One wrist / eight channels - design in progress")) (lib_symbols )(text "BATTERY AND POWER / DESIGN RESERVED" (at 25.4 25.4 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid 7f8da056-256f-41b4-a16e-f3acf3c34deb))(text "Battery-powered wrist unit. This sheet intentionally has no electrical implementation yet." (at 25.4 40.64 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid 6812d370-68f0-4c54-ab31-68f1a77772b8))(text "To select in the next design pass:\n\n- Cell chemistry, capacity and mechanical envelope\n- Charging interface, charger, protection and power switch\n- Regulated 3V3 supply sized for ESP32-C6 radio plus actuator transients\n- Whether the actuator choice calls for a separate haptic supply\n- Battery measurement and low-battery behavior\n- Connectors / interconnect strategy for the wrist ring" (at 25.4 58.42 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid f1695664-3dc3-4f17-bba1-1e7be6e4c8a8))(text "The present schematic has unpowered 3V3 and GND nets.\nDo not suppress those ERC findings with power flags before adding the supply circuit." (at 25.4 119.38 0) (effects (font (size 1.8 1.8)) (justify left top)) (uuid 11d21c5f-f576-4fdd-b5e4-5d0a98dd8faa))(embedded_fonts no))