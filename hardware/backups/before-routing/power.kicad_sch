BAT; PACK- -> GND.\nVBAT connects directly to U11 BAT and stays live in ship mode.\n720mAh nominal; 360mA continuous total with equal sharing." (at 20.32 246.38 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid ae15ed01-4504-4935-a7e8-1eff456c2da3)) (symbol (lib_id "power:PWR_FLAG") (at 289.56 238.76 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 41ee80d4-127f-428d-b438-3199cbeb35fc) (property "Reference" "#FLG08" (at 297.18 233.67999999999998 0) (effects (font (size 1.0 1.0)) (justify left))) (property "Value" "PWR_FLAG" (at 297.18 236.21999999999997 0) (effects (font (size 1.0 1.0)) (justify left))) (property "Footprint" "" (at 297.18 233.67999999999998 0) (effects (font (size 1.0 1.0)) (hide yes))) (property "Datasheet" "" (at 297.18 233.67999999999998 0) (effects (font (size 1.0 1.0)) (hide yes))) (pin "1" (uuid 0b39bc4e-12c8-4934-a18c-628d3a763f95)) (instances (project "haptic-bracelet" (path "/281e434a-bf9f-4327-92ec-86d5315beda6/2aea65ce-3f94-40c4-86ee-85ece296249c" (reference "#FLG08") (unit 1))))) (wire (pts (xy 289.56 238.76) (xy 289.56 243.84)) (stroke (width 0) (type default)) (uuid 66c176d3-8b2d-41e4-a7e7-df3d67465638)) (global_label "VBAT" (at 289.56 243.84 0) (shape bidirectional) (effects (font (size 1 1)) (justify left bottom)) (uuid 62f33fb1-6b36-4599-9ddf-167cd871bbdf)) (text "22u additional bulk on each POD_3V3 branch.\nC42 = 4.7n: slower controlled pod-rail startup.\nBattery protection is external to these PCBs." (at 243.84 256.54 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid 4a92bce4-78af-486f-b0d8-96438204735a)))
