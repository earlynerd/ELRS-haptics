	(title_block
		(title "Haptic bracelet - UART ring wiring")
		(date "2026-09-12")
		(rev "0.5")
		(comment 1 "One wrist / ring pod schematic draft")
	)
	(lib_symbols)
	(text "IN/OUT: 1 switched 3V3, 2 GND, 3 forward DATA, 4 MCU reset, 5 VBAT, 6 RETURN to ESP RX."
		(exclude_from_sim no)
		(at 20.32 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "13175acc-6f0b-4048-aee4-f634f9576135")
	)
	(text "ESP TX -> D0 -> pod 0 -> D1 -> ... -> pod 7 -> D8 -> R53 -> RETURN -> ESP RX\nRETURN passes through each intermediate board without an MCU connection. R53 fitted at end pod only.\nWire J101->J104, J105->J108, ... J125->J128 pin-for-pin. No cable between end pod and main pod across clasp.\nPower, GND, reset and VBAT follow the chain; each pod has a protected battery and local positive fuse."
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4f281aac-3bdf-4056-aa73-4be97600f9b6")
	)
	(text "Each pod: M2003FC1AE + DRV2625 + LRA. Pod 0 shares its housing with the ESP32/power electronics."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a3cb6076-a69f-407d-99f0-ed80eb90651c")
	)
	(text "EIGHT PODS / SIX-WIRE CHAIN / LOGICAL UART RING"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
