		(uuid "944e7abe-26b2-4118-b0a2-6bbe4f38f36c")
	)
	(text "C34: IN bypass    C35: SYS reservoir    C36: BAT bypass\nSW3: wake/ship button. R62: fixed TS/MR termination.\nCell and NTC use J200/J103 on the local pod sheet, as on satellites.\nFirmware checks every pod temperature before enabling charge."
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d447da8e-5479-4042-99f8-672d6d4cbd19")
	)
